# ─── Demo / AI mode ────────────────────────────────────────────────────────
# "true" = use pre-generated mock data, no AWS creds needed
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Amazon Bedrock (real AI) ───────────────────────────────────────────────
# Credentials are resolved automatically via the SDK default chain:
#   Local dev  → AWS CLI profile (run: aws configure sso  OR  aws configure)
#   AWS deploy → IAM role attached to EC2 / ECS / Lambda (no keys needed)
#   CI/CD      → Set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY as secrets
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=only_needed_if_not_using_cli_profile_or_iam_role
# AWS_SECRET_ACCESS_KEY=only_needed_if_not_using_cli_profile_or_iam_role

# ─── Amazon S3 (file storage) ───────────────────────────────────────────────
AWS_S3_BUCKET=lessonlens-uploads

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# Production: postgresql://user:pass@host:5432/lessonlens
# Uses Prisma v7 with pg driver adapter — PostgreSQL only
DATABASE_URL=postgresql://user:pass@localhost:5432/lessonlens

# ─── Auth ─────────────────────────────────────────────────────────────────
# Set to "true" to enable login UI (also requires NEXTAUTH_SECRET + DATABASE_URL)
NEXT_PUBLIC_AUTH_ENABLED=false
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change_me
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Simple Gate Login (shared credentials) ────────────────────────────────
# Set all 3 to enable login gate. Leave unset for open access.
# GATE_USER=judge
# GATE_PASS=your_password
# GATE_TOKEN=run_openssl_rand_-hex_16
